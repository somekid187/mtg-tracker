<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{{appName}} - {{#if resetUrl}}Reset your password{{else}}Activate your account{{/if}}</title>
  </head>
  <body style="margin:0;padding:0;background:#f6f7fb;font-family:Arial,Helvetica,sans-serif;color:#111827;">
    <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="background:#f6f7fb;padding:24px 12px;">
      <tr>
        <td align="center">
          <table role="presentation" cellpadding="0" cellspacing="0" width="600" style="max-width:600px;background:#ffffff;border-radius:14px;overflow:hidden;box-shadow:0 8px 30px rgba(17,24,39,0.08);">
            <tr>
              <td style="padding:22px 24px;background:#111827;color:#ffffff;">
                <div style="font-size:16px;font-weight:700;letter-spacing:0.2px;">{{appName}}</div>
              </td>
            </tr>
            <tr>
              <td style="padding:26px 24px 8px 24px;">
                <div style="font-size:20px;font-weight:700;line-height:1.25;">
                  {{#if resetUrl}}Reset your password{{else}}Activate your account{{/if}}
                </div>
              </td>
            </tr>
            <tr>
              <td style="padding:0 24px 16px 24px;">
                <div style="font-size:14px;line-height:1.55;color:#374151;">
                  Hi <strong style="color:#111827;">{{name}}</strong>,
                  {{#if resetUrl}}
                    we received a request to reset your password. Use the code below or the button to proceed.
                  {{else}}
                    thanks for signing up. Use the activation code below to verify your email address.
                  {{/if}}
                </div>
              </td>
            </tr>
            <tr>
              <td style="padding:0 24px 18px 24px;">
                <div style="background:#f3f4f6;border:1px solid #e5e7eb;border-radius:12px;padding:14px 16px;">
                  <div style="font-size:12px;color:#6b7280;margin-bottom:6px;">
                    {{#if resetUrl}}Reset code{{else}}Activation code{{/if}}
                  </div>
                  <div style="font-size:18px;font-weight:700;letter-spacing:1px;color:#111827;word-break:break-all;">{{code}}</div>
                </div>
              </td>
            </tr>

            {{#if resetUrl}}
            <tr>
              <td style="padding:0 24px 22px 24px;">
                <a href="{{resetUrl}}" style="display:inline-block;background:#2563eb;color:#ffffff;text-decoration:none;padding:12px 16px;border-radius:10px;font-weight:700;font-size:14px;">
                  Reset password
                </a>
                <div style="font-size:12px;color:#6b7280;margin-top:10px;line-height:1.45;">
                  Or paste this link into your browser:<br/>
                  <span style="color:#374151;word-break:break-all;">{{resetUrl}}</span>
                </div>
              </td>
            </tr>
            {{else if activationUrl}}
            <tr>
              <td style="padding:0 24px 22px 24px;">
                <a href="{{activationUrl}}" style="display:inline-block;background:#2563eb;color:#ffffff;text-decoration:none;padding:12px 16px;border-radius:10px;font-weight:700;font-size:14px;">
                  Activate account
                </a>
                <div style="font-size:12px;color:#6b7280;margin-top:10px;line-height:1.45;">
                  Or paste this link into your browser:<br/>
                  <span style="color:#374151;word-break:break-all;">{{activationUrl}}</span>
                </div>
              </td>
            </tr>
            {{/if}}

            <tr>
              <td style="padding:0 24px 26px 24px;">
                <div style="font-size:12px;line-height:1.5;color:#6b7280;">
                  {{#if resetUrl}}
                    If you didn’t request a password reset, you can safely ignore this email.
                  {{else}}
                    If you didn’t create an account, you can safely ignore this email.
                  {{/if}}
                </div>
              </td>
            </tr>
          </table>
          <div style="max-width:600px;font-size:11px;color:#9ca3af;line-height:1.5;padding:10px 8px;">
            © {{year}} {{appName}}
          </div>
        </td>
      </tr>
    </table>
  </body>
</html>

